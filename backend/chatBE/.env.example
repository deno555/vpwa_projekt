# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (MySQL / MariaDB)
# Lokálna MariaDB podľa MYSQL_SETUP.md: root / chat
# Docker (database/chatDB/docker-compose.yml): DB_USER=chat_user, DB_PASSWORD=chat_password, DB_DATABASE=chat_db
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=chat

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:9000
